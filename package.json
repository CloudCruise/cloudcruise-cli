{
  "name": "@cloudcruise/cli",
  "version": "1.16.1",
  "description": "CLI for managing CloudCruise browser automation workflows and runs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudCruise/cloudcruise-cli.git"
  },
  "homepage": "https://github.com/CloudCruise/cloudcruise-cli",
  "bugs": {
    "url": "https://github.com/CloudCruise/cloudcruise-cli/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "cloudcruise",
    "cli",
    "browser-automation",
    "workflow",
    "coding-agent",
    "mcp",
    "ai-agent"
  ],
  "bin": {
    "cloudcruise": "./dist/bin/cloudcruise.js"
  },
  "scripts": {
    "build": "npm run build -w @cloudcruise/strata && tsc",
    "dev": "npm run build -w @cloudcruise/strata && (npm run dev -w @cloudcruise/strata & tsc --watch)",
    "typecheck": "npm run build -w @cloudcruise/strata && tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && npm test -w @cloudcruise/strata && node --test test/*.test.ts",
    "build:openai-plugin": "node scripts/build-openai-plugin.mjs"
  },
  "files": [
    ".env.example",
    "assets",
    "dist",
    "skills"
  ],
  "dependencies": {
    "@cloudcruise/strata": "1.16.1",
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^13.0.0",
    "fontoxpath": "^3.34.0",
    "linkedom": "^0.18.12",
    "std-env": "^4.3.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
