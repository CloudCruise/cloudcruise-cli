{
  "openapi": "3.0.0",
  "info": { "title": "Fixture API", "version": "1.0" },
  "paths": {
    "/workflows": {
      "get": {
        "operationId": "WorkflowsController_list",
        "summary": "List workflows",
        "description": "List the workflows in the current workspace, newest first.",
        "x-strata-surfaces": ["cli", "mcp"],
        "x-strata-name": "workflows.list",
        "x-strata-hints": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "Most workflows to return." },
          { "name": "tags", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Workflow" } } } }
          }
        }
      }
    },
    "/workflows/{workflowId}": {
      "parameters": [
        { "name": "workflowId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "WorkflowsController_get",
        "summary": "Get a workflow",
        "description": "Fetch one workflow by id, including its latest version.",
        "x-strata-surfaces": ["cli", "mcp"],
        "x-strata-name": "workflows.get",
        "x-strata-hints": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
        "responses": {
          "200": { "description": "", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workflow" } } } }
        }
      },
      "delete": {
        "operationId": "WorkflowsController_delete",
        "summary": "Delete a workflow",
        "description": "Delete a workflow and all of its versions.",
        "x-strata-surfaces": ["cli"],
        "x-strata-name": "workflows.delete",
        "x-strata-hints": { "readOnlyHint": false, "destructiveHint": true, "idempotentHint": true, "openWorldHint": false },
        "responses": { "204": { "description": "" } }
      }
    },
    "/run": {
      "post": {
        "operationId": "RunController_createRun",
        "summary": "Start a workflow run",
        "description": "Start a run of a workflow with the given input variables. The run continues in the background.",
        "x-strata-surfaces": ["mcp", "cli"],
        "x-strata-name": "runs.start",
        "x-strata-hints": { "readOnlyHint": false, "destructiveHint": false, "idempotentHint": false, "openWorldHint": true },
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartRun" } } }
        },
        "responses": {
          "202": { "description": "", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunStarted" } } } }
        }
      }
    },
    "/run/{sessionId}": {
      "get": {
        "operationId": "RunController_get",
        "summary": "Get a run",
        "description": "Status and output of one run.",
        "x-strata-surfaces": ["mcp"],
        "x-strata-name": "runs.get",
        "x-strata-hints": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "X-Trace", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/run/{sessionId}/steps": {
      "get": {
        "operationId": "RunController_steps",
        "summary": "List the steps of a run",
        "x-strata-surfaces": ["mcp"],
        "x-strata-name": "runs.steps",
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "" } }
      }
    },
    "/vault": {
      "post": {
        "operationId": "VaultController_create",
        "summary": "Store a credential",
        "x-strata-surfaces": [],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "201": { "description": "" } }
      }
    },
    "/users/me": {
      "get": {
        "operationId": "UsersController_me",
        "summary": "The signed-in user",
        "responses": { "200": { "description": "" } }
      }
    },
    "/runs/export": {
      "get": {
        "operationId": "RunController_export",
        "summary": "Export runs",
        "x-strata-surfaces": ["mcp"],
        "responses": { "200": { "description": "" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Workflow": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "StartRun": {
        "type": "object",
        "required": ["workflow_id", "run_input_variables"],
        "properties": {
          "workflow_id": { "type": "string" },
          "run_input_variables": { "type": "object", "additionalProperties": true },
          "priority_level": { "type": "string", "enum": ["HIGH", "LOW"], "nullable": true, "example": "HIGH" },
          "webhook": { "allOf": [{ "$ref": "#/components/schemas/Webhook" }], "nullable": true }
        }
      },
      "Webhook": {
        "type": "object",
        "required": ["url"],
        "properties": { "url": { "type": "string" } }
      },
      "RunStarted": {
        "type": "object",
        "properties": { "session_id": { "type": "string" } }
      }
    }
  }
}
